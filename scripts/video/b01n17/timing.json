{"units": [{"i": 0, "p": 0, "t0": 0.0, "t1": 5.8, "text": "Ahli kehutanan, petani padi, dan ahli iklim dunia sama-sama butuh peta iklim.", "v0": 3.0, "v1": 8.8}, {"i": 1, "p": 0, "t0": 6.45, "t1": 9.23, "text": "Tetapi kebutuhan mereka berbeda.", "v0": 9.45, "v1": 12.23}, {"i": 2, "p": 0, "t0": 9.53, "t1": 13.16, "text": "Karena itu, ada banyak cara mengelompokkan iklim.", "v0": 12.53, "v1": 16.16}, {"i": 3, "p": 0, "t0": 13.44, "t1": 17.66, "text": "Untuk OSN, tiga yang paling penting adalah Koppen, Schmidt Ferguson, dan Oldeman.", "v0": 16.44, "v1": 20.66}, {"i": 4, "p": 1, "t0": 18.36, "t1": 24.66, "text": "Kita mulai dari Koppen, atau Koppen climate classification, yang dipakai untuk iklim seluruh dunia.", "v0": 21.36, "v1": 27.66}, {"i": 5, "p": 1, "t0": 25.21, "t1": 29.85, "text": "Dasarnya suhu rata-rata bulanan, curah hujan, dan hubungannya dengan tumbuhan.", "v0": 28.21, "v1": 32.85}, {"i": 6, "p": 1, "t0": 30.41, "t1": 33.4, "text": "Iklim dibagi menjadi lima kelompok besar dengan huruf.", "v0": 33.41, "v1": 36.4}, {"i": 7, "p": 2, "t0": 33.62, "t1": 38.09, "text": "A untuk tropis, kalau suhu bulan terdingin masih delapan belas derajat atau lebih.", "v0": 36.62, "v1": 41.09}, {"i": 8, "p": 2, "t0": 38.74, "t1": 42.14, "text": "B untuk kering, kalau penguapan lebih besar daripada hujan.", "v0": 41.74, "v1": 45.14}, {"i": 9, "p": 2, "t0": 42.88, "t1": 43.85, "text": "C untuk sedang.", "v0": 45.88, "v1": 46.85}, {"i": 10, "p": 2, "t0": 44.27, "t1": 45.25, "text": "D untuk dingin.", "v0": 47.27, "v1": 48.25}, {"i": 11, "p": 2, "t0": 45.9, "t1": 49.97, "text": "Dan E untuk kutub, kalau bulan terpanas pun di bawah sepuluh derajat.", "v0": 48.9, "v1": 52.97}, {"i": 12, "p": 3, "t0": 50.67, "t1": 52.71, "text": "Hampir seluruh Indonesia termasuk A.", "v0": 53.67, "v1": 55.71}, {"i": 13, "p": 3, "t0": 53.37, "t1": 56.51, "text": "Huruf kedua lalu ditentukan oleh hujan di bulan terkering.", "v0": 56.37, "v1": 59.51}, {"i": 14, "p": 3, "t0": 57.2, "t1": 63.68, "text": "Kalau bulan terkering masih di atas atau sama dengan enam puluh milimeter, iklimnya Af, hutan hujan tropis.", "v0": 60.2, "v1": 66.68}, {"i": 15, "p": 3, "t0": 63.9, "t1": 66.56, "text": "Kalau di bawah enam puluh, kita hitung ambangnya:", "v0": 66.9, "v1": 69.56}, {"i": 16, "p": 3, "t0": 67.0, "t1": 70.67, "text": "seratus dikurangi curah hujan tahunan dibagi dua puluh lima.", "v0": 70.0, "v1": 73.67}, {"i": 17, "p": 3, "t0": 71.19, "t1": 76.57, "text": "Kalau bulan terkering masih di atas ambang itu, iklimnya Am, monsun tropis.", "v0": 74.19, "v1": 79.57}, {"i": 18, "p": 3, "t0": 77.24, "t1": 80.32, "text": "Kalau di bawahnya, iklimnya Aw, sabana.", "v0": 80.24, "v1": 83.32}, {"i": 19, "p": 4, "t0": 80.76, "t1": 81.19, "text": "Contoh.", "v0": 83.76, "v1": 84.19}, {"i": 20, "p": 4, "t0": 81.71, "t1": 88.42, "text": "Sebuah kota punya hujan tahunan dua ribu dua ratus milimeter dan bulan terkeringnya empat puluh lima milimeter.", "v0": 84.71, "v1": 91.42}, {"i": 21, "p": 4, "t0": 89.12, "t1": 92.52, "text": "Empat puluh lima di bawah enam puluh, jadi bukan Af.", "v0": 92.12, "v1": 95.52}, {"i": 22, "p": 4, "t0": 92.8, "t1": 102.1, "text": "Ambangnya seratus dikurangi dua ribu dua ratus dibagi dua puluh lima, yaitu seratus dikurangi delapan puluh delapan, sama dengan dua belas.", "v0": 95.8, "v1": 105.1}, {"i": 23, "p": 4, "t0": 102.74, "t1": 105.0, "text": "Empat puluh lima lebih besar dari dua belas.", "v0": 105.74, "v1": 108.0}, {"i": 24, "p": 4, "t0": 105.53, "t1": 106.6, "text": "Jadi iklimnya Am.", "v0": 108.53, "v1": 109.6}, {"i": 25, "p": 5, "t0": 106.74, "t1": 112.99, "text": "Berikutnya Schmidt Ferguson, yang dibuat untuk perkebunan dan kehutanan di Indonesia.", "v0": 109.74, "v1": 115.99}, {"i": 26, "p": 5, "t0": 113.67, "t1": 116.08, "text": "Dasarnya jumlah bulan kering dan bulan basah.", "v0": 116.67, "v1": 119.08}, {"i": 27, "p": 5, "t0": 116.75, "t1": 120.31, "text": "Bulan basah adalah bulan dengan hujan lebih dari seratus milimeter.", "v0": 119.75, "v1": 123.31}, {"i": 28, "p": 5, "t0": 120.99, "t1": 123.88, "text": "Bulan kering, kurang dari enam puluh milimeter.", "v0": 123.99, "v1": 126.88}, {"i": 29, "p": 6, "t0": 124.14, "t1": 125.55, "text": "Lalu hitung nilai Q:", "v0": 127.14, "v1": 128.55}, {"i": 30, "p": 6, "t0": 125.97, "t1": 131.19, "text": "rata-rata jumlah bulan kering dibagi rata-rata jumlah bulan basah, dikali seratus persen.", "v0": 128.97, "v1": 134.19}, {"i": 31, "p": 6, "t0": 131.84, "t1": 133.81, "text": "Makin kecil Q, makin basah.", "v0": 134.84, "v1": 136.81}, {"i": 32, "p": 6, "t0": 134.49, "t1": 138.66, "text": "Tipe A, Q kurang dari empat belas koma tiga persen, sangat basah.", "v0": 137.49, "v1": 141.66}, {"i": 33, "p": 6, "t0": 139.21, "t1": 146.97, "text": "Lalu B, C, D, dan seterusnya, sampai tipe H yang luar biasa kering, dengan Q di atas tujuh ratus persen.", "v0": 142.21, "v1": 149.97}, {"i": 34, "p": 7, "t0": 147.44, "t1": 150.96, "text": "Ketiga Oldeman, yang dibuat khusus untuk padi dan palawija.", "v0": 150.44, "v1": 153.96}, {"i": 35, "p": 7, "t0": 151.59, "t1": 158.87, "text": "Oldeman menghitung bulan basah berturut-turut, yaitu bulan dengan hujan lebih dari dua ratus milimeter, cukup untuk padi sawah.", "v0": 154.59, "v1": 161.87}, {"i": 36, "p": 7, "t0": 159.03, "t1": 163.72, "text": "Makin banyak bulan basah berturut-turut, makin sering padi bisa ditanam dalam setahun.", "v0": 162.03, "v1": 166.72}, {"i": 37, "p": 8, "t0": 164.28, "t1": 165.35, "text": "Jadi ingat pasangannya.", "v0": 167.28, "v1": 168.35}, {"i": 38, "p": 8, "t0": 165.74, "t1": 167.18, "text": "Koppen untuk iklim dunia.", "v0": 168.74, "v1": 170.18}, {"i": 39, "p": 8, "t0": 167.62, "t1": 170.46, "text": "Schmidt Ferguson untuk perkebunan dan kehutanan.", "v0": 170.62, "v1": 173.46}, {"i": 40, "p": 8, "t0": 171.01, "t1": 173.76, "text": "Oldeman untuk tanaman pangan, terutama padi.", "v0": 174.01, "v1": 176.76}, {"i": 41, "p": 9, "t0": 174.52, "t1": 176.41, "text": "Sekarang, coba kerjakan soal ini.", "v0": 177.52, "v1": 179.41}, {"i": 42, "p": 10, "t0": 176.87, "t1": 184.0, "text": "Nilai Q awal adalah empat koma dua dibagi enam, dikali seratus persen, yaitu tujuh puluh persen, tipe D.", "v0": 183.87, "v1": 191.0}, {"i": 43, "p": 10, "t0": 184.71, "t1": 191.37, "text": "Nilai Q baru adalah lima koma empat dibagi lima koma satu, sekitar seratus enam persen, tipe E.", "v0": 191.71, "v1": 198.37}, {"i": 44, "p": 10, "t0": 191.62, "t1": 195.3, "text": "Jadi iklimnya bergeser dari D ke E, menjadi lebih kering.", "v0": 198.62, "v1": 202.3}, {"i": 45, "p": 10, "t0": 195.96, "t1": 197.28, "text": "Jawabannya B.", "v0": 202.96, "v1": 204.28}, {"i": 46, "p": 11, "t0": 197.97, "t1": 198.92, "text": "Ada dua jebakan.", "v0": 204.97, "v1": 205.92}, {"i": 47, "p": 11, "t0": 199.54, "t1": 201.96, "text": "Pertama, batas bulan basah berbeda-beda.", "v0": 206.54, "v1": 208.96}, {"i": 48, "p": 11, "t0": 202.52, "t1": 207.81, "text": "Schmidt Ferguson memakai seratus milimeter, sedangkan Oldeman memakai dua ratus milimeter.", "v0": 209.52, "v1": 214.81}, {"i": 49, "p": 11, "t0": 208.45, "t1": 212.95, "text": "Kedua, nilai Q yang makin besar berarti makin kering, bukan makin basah.", "v0": 215.45, "v1": 219.95}, {"i": 50, "p": 12, "t0": 213.62, "t1": 214.25, "text": "Ringkasnya:", "v0": 220.62, "v1": 221.25}, {"i": 51, "p": 12, "t0": 214.56, "t1": 223.97, "text": "Koppen memakai suhu dan hujan untuk iklim dunia, Schmidt Ferguson memakai nilai Q untuk kehutanan, dan Oldeman memakai bulan basah berturut-turut untuk padi.", "v0": 221.56, "v1": 230.97}, {"i": 52, "p": 12, "t0": 224.18, "t1": 226.53, "text": "Berikutnya, arus laut dan upwelling.", "v0": 231.18, "v1": 233.53}, {"i": 53, "p": 12, "t0": 227.18, "t1": 230.68, "text": "Latihan soalnya ada di O S N Geo titik I D.", "v0": 234.18, "v1": 237.68}], "words": [{"w": "Ahli", "t": 3.0, "u": 0}, {"w": "kehutanan,", "t": 3.51, "u": 0}, {"w": "petani", "t": 4.53, "u": 0}, {"w": "padi,", "t": 5.24, "u": 0}, {"w": "dan", "t": 5.72, "u